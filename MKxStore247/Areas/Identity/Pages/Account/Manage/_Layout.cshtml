@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body bg-primary text-white rounded">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="fas fa-user-circle fa-3x"></i>
                        </div>
                        <div>
                            <h1 class="h3 mb-1">Quản lý tài khoản</h1>
                            <p class="mb-0 opacity-75">Cập nhật thông tin cá nhân và cài đặt tài khoản</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="row g-4">
        <!-- Navigation Sidebar -->
        <div class="col-lg-3 col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light border-0">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-cogs me-2"></i>
                        Cài đặt tài khoản
                    </h5>
                </div>
                <div class="card-body p-0">
                    <partial name="_ManageNav" />
                </div>
            </div>
        </div>

        <!-- Content Area -->
        <div class="col-lg-9 col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(ViewData["StatusMessage"]?.ToString()))
                    {
                        var statusMessage = ViewData["StatusMessage"].ToString();
                        var alertClass = statusMessage.Contains("thành công") || statusMessage.Contains("updated") ? "alert-success" : "alert-danger";

                        <div class="alert @alertClass alert-dismissible fade show" role="alert">
                            <i class="fas @(alertClass == "alert-success" ? "fa-check-circle" : "fa-exclamation-triangle") me-2"></i>
                            @statusMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}