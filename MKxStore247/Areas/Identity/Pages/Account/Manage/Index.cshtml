@page
@model IndexModel
@{
    ViewData["Title"] = "Thông tin cá nhân";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="row">
    <div class="col-12">
        <div class="d-flex align-items-center mb-4">
            <h2 class="h4 mb-0">
                <i class="fas fa-user me-2 text-primary"></i>
                Thông tin cá nhân
            </h2>
        </div>
    </div>
</div>

<form id="profile-form" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <!-- Hidden input for AvatarUrl -->
    <input asp-for="Input.AvatarUrl" type="hidden" id="avatarUrlInput">

    <!-- Hidden file input for avatar upload -->
    <input type="file" id="avatarFileInput" accept="image/*" style="display: none;" onchange="handleFileSelect(this)">

    <!-- Avatar Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 bg-light">
                <div class="card-body text-center py-4">
                    <div class="position-relative d-inline-block">
                        @if (!string.IsNullOrEmpty(Model.Input.AvatarUrl))
                        {
                            <img src="@Model.Input.AvatarUrl" alt="Avatar" class="rounded-circle border border-3 border-white shadow"
                                 style="width: 120px; height: 120px; object-fit: cover;" id="avatar-preview">
                        }
                        else
                        {
                            <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center border border-3 border-white shadow"
                                 style="width: 120px; height: 120px;" id="avatar-preview">
                                <i class="fas fa-user fa-3x text-white"></i>
                            </div>
                        }
                        <button type="button" class="btn btn-primary btn-sm position-absolute bottom-0 end-0 rounded-circle"
                                style="width: 35px; height: 35px;" data-bs-toggle="modal" data-bs-target="#avatarModal">
                            <i class="fas fa-camera"></i>
                        </button>
                    </div>
                    <h5 class="mt-3 mb-1">@(Model.Input.FullName ?? "Chưa cập nhật")</h5>
                    <p class="text-muted mb-0">@Model.Username</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Personal Information -->
    <div class="row g-4">
        <!-- Left Column -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>
                        Thông tin cơ bản
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Full Name -->
                    <div class="mb-3">
                        <label asp-for="Input.FullName" class="form-label fw-bold">
                            <i class="fas fa-user me-1"></i>
                            @Html.DisplayNameFor(m => m.Input.FullName)
                        </label>
                        <input asp-for="Input.FullName" class="form-control form-control-lg" placeholder="Nhập họ và tên của bạn">
                        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                    </div>

                    <!-- Gender -->
                    <div class="mb-3">
                        <label asp-for="Input.Gender" class="form-label fw-bold">
                            <i class="fas fa-venus-mars me-1"></i>
                            @Html.DisplayNameFor(m => m.Input.Gender)
                        </label>
                        <select asp-for="Input.Gender" class="form-select form-select-lg">
                            <option value="">-- Chọn giới tính --</option>
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                        <span asp-validation-for="Input.Gender" class="text-danger small"></span>
                    </div>

                    <!-- Date of Birth -->
                    <div class="mb-3">
                        <label asp-for="Input.DateOfBirth" class="form-label fw-bold">
                            <i class="fas fa-birthday-cake me-1"></i>
                            @Html.DisplayNameFor(m => m.Input.DateOfBirth)
                        </label>
                        <input asp-for="Input.DateOfBirth" type="date" class="form-control form-control-lg"
                               max="@DateTime.Now.AddYears(-13).ToString("yyyy-MM-dd")">
                        <span asp-validation-for="Input.DateOfBirth" class="text-danger small"></span>
                        <div class="form-text">Bạn phải từ 13 tuổi trở lên</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-address-card me-2"></i>
                        Thông tin liên hệ
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-bold">
                            <i class="fas fa-envelope me-1"></i>
                            @Html.DisplayNameFor(m => m.Input.Email)
                        </label>
                        <input asp-for="Input.Email" class="form-control form-control-lg" placeholder="email@example.com">
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <!-- Phone Number -->
                    <div class="mb-3">
                        <label asp-for="Input.PhoneNumber" class="form-label fw-bold">
                            <i class="fas fa-phone me-1"></i>
                            @Html.DisplayNameFor(m => m.Input.PhoneNumber)
                        </label>
                        <input asp-for="Input.PhoneNumber" class="form-control form-control-lg" placeholder="0123456789">
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                    </div>

                    <!-- Address -->
                    <div class="mb-3">
                        <label asp-for="Input.Address" class="form-label fw-bold">
                            <i class="fas fa-map-marker-alt me-1"></i>
                            @Html.DisplayNameFor(m => m.Input.Address)
                        </label>
                        <textarea asp-for="Input.Address" class="form-control" rows="3" placeholder="Nhập địa chỉ của bạn"></textarea>
                        <span asp-validation-for="Input.Address" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Submit Button -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <button type="button" class="btn btn-outline-secondary btn-lg me-md-2" onclick="location.reload()">
                    <i class="fas fa-undo me-2"></i>
                    Làm mới
                </button>
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-save me-2"></i>
                    Cập nhật thông tin
                </button>
            </div>
        </div>
    </div>
</form>

<!-- Avatar Modal -->
<div class="modal fade" id="avatarModal" tabindex="-1" aria-labelledby="avatarModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="avatarModalLabel">
                    <i class="fas fa-image me-2"></i>
                    Cập nhật ảnh đại diện
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="avatarUrlTemp" class="form-label fw-bold">URL ảnh đại diện</label>
                    <input id="avatarUrlTemp" class="form-control" placeholder="https://example.com/avatar.jpg"
                           onchange="updateAvatarPreview(this.value)">
                    <div class="form-text">Nhập URL của ảnh đại diện</div>
                </div>

                <div class="text-center mb-3">
                    <div class="d-flex align-items-center justify-content-center mb-2">
                        <hr class="flex-grow-1">
                        <span class="px-3 text-muted">HOẶC</span>
                        <hr class="flex-grow-1">
                    </div>
                    <button type="button" class="btn btn-outline-primary" onclick="document.getElementById('avatarFileInput').click()">
                        <i class="fas fa-upload me-2"></i>
                        Chọn ảnh từ máy tính
                    </button>
                    <div class="form-text mt-2">Chọn file ảnh (JPG, PNG, GIF) - Tối đa 5MB</div>
                </div>

                <div class="text-center">
                    <div id="modal-avatar-preview" class="mb-3">
                        @if (!string.IsNullOrEmpty(Model.Input.AvatarUrl))
                        {
                            <img src="@Model.Input.AvatarUrl" alt="Avatar Preview" class="rounded-circle"
                                 style="width: 100px; height: 100px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center mx-auto"
                                 style="width: 100px; height: 100px;">
                                <i class="fas fa-user fa-2x text-white"></i>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="saveAvatarUrl()" data-bs-dismiss="modal">Lưu thay đổi</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Initialize temp input with current value
        document.addEventListener('DOMContentLoaded', function() {
            const avatarUrlInput = document.getElementById('avatarUrlInput');
            const avatarUrlTemp = document.getElementById('avatarUrlTemp');
            if (avatarUrlInput.value) {
                avatarUrlTemp.value = avatarUrlInput.value;
                updateAvatarPreview(avatarUrlInput.value);
            } else {
                updateAvatarPreview('');
            }
        });

        function handleFileSelect(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];

                // Validate file type
                if (!file.type.match('image.*')) {
                    alert('Vui lòng chọn file ảnh!');
                    return;
                }

                // Validate file size (5MB)
                if (file.size > 5 * 1024 * 1024) {
                    alert('Kích thước file không được vượt quá 5MB!');
                    return;
                }

                // Create FileReader to convert to base64
                const reader = new FileReader();
                reader.onload = function(e) {
                    const base64String = e.target.result;
                    document.getElementById('avatarUrlTemp').value = base64String;
                    updateAvatarPreview(base64String);
                };
                reader.readAsDataURL(file);
            }
        }

        function updateAvatarPreview(url) {
            const preview = document.getElementById('avatar-preview');
            const modalPreview = document.getElementById('modal-avatar-preview');

            if (url && url.trim()) {
                // Update main avatar
                preview.innerHTML = `<img src="${url}" alt="Avatar" class="rounded-circle border border-3 border-white shadow"
                                    style="width: 120px; height: 120px; object-fit: cover;"
                                    onerror="this.parentElement.innerHTML='<div class=\\'rounded-circle bg-primary d-flex align-items-center justify-content-center border border-3 border-white shadow\\' style=\\'width: 120px; height: 120px;\\'><i class=\\'fas fa-user fa-3x text-white\\'></i></div>'">`;

                // Update modal preview
                modalPreview.innerHTML = `<img src="${url}" alt="Avatar Preview" class="rounded-circle border"
                                         style="width: 120px; height: 120px; object-fit: cover;"
                                         onerror="this.parentElement.innerHTML='<div class=\\'rounded-circle bg-secondary d-flex align-items-center justify-content-center mx-auto\\' style=\\'width: 120px; height: 120px;\\'><i class=\\'fas fa-user fa-2x text-white\\'></i></div>'">`;
            } else {
                // Reset to default
                preview.innerHTML = `<div class="rounded-circle bg-primary d-flex align-items-center justify-content-center border border-3 border-white shadow"
                                    style="width: 120px; height: 120px;">
                                    <i class="fas fa-user fa-3x text-white"></i>
                                    </div>`;
                modalPreview.innerHTML = `<div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center mx-auto"
                                         style="width: 120px; height: 120px;">
                                         <i class="fas fa-user fa-2x text-white"></i>
                                         </div>`;
            }
        }

        function saveAvatarUrl() {
            const avatarUrlTemp = document.getElementById('avatarUrlTemp');
            const avatarUrlInput = document.getElementById('avatarUrlInput');
            avatarUrlInput.value = avatarUrlTemp.value;
        }

        // Form validation enhancement
        document.getElementById('profile-form').addEventListener('submit', function(e) {
            const submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang cập nhật...';

            setTimeout(() => {
                if (submitBtn.disabled) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fas fa-save me-2"></i>Cập nhật thông tin';
                }
            }, 5000);
        });

        // Auto-hide alerts
        document.addEventListener('DOMContentLoaded', function() {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    if (alert && alert.classList.contains('show')) {
                        alert.classList.remove('show');
                        setTimeout(() => alert.remove(), 150);
                    }
                }, 5000);
            });
        });
    </script>
}