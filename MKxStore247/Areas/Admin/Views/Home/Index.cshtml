<main class="content-area">
    <h1 class="page-title animate__animated animate__fadeInDown">Dashboard Tổng quan</h1>

    <div class="dashboard-cards">
        <div class="dashboard-card animate__animated animate__fadeInUp" style="animation-delay: 0.1s;">
            <div class="card-header">
                <div class="card-icon users">
                    <i class="fas fa-users"></i>
                </div>
                <div class="card-trend up">
                    <i class="fas fa-arrow-up"></i>
                    <span>+12%</span>
                </div>
            </div>
            <div class="card-value">1,234</div>
            <div class="card-label">Người dùng</div>
        </div>

        <div class="dashboard-card animate__animated animate__fadeInUp" style="animation-delay: 0.2s;">
            <div class="card-header">
                <div class="card-icon orders">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <div class="card-trend up">
                    <i class="fas fa-arrow-up"></i>
                    <span>+8%</span>
                </div>
            </div>
            <div class="card-value">567</div>
            <div class="card-label">Đơn hàng</div>
        </div>

        <div class="dashboard-card animate__animated animate__fadeInUp" style="animation-delay: 0.3s;">
            <div class="card-header">
                <div class="card-icon revenue">
                    <i class="fas fa-dollar-sign"></i>
                </div>
                <div class="card-trend up">
                    <i class="fas fa-arrow-up"></i>
                    <span>+15%</span>
                </div>
            </div>
            <div class="card-value">$89,234</div>
            <div class="card-label">Doanh thu</div>
        </div>

        <div class="dashboard-card animate__animated animate__fadeInUp" style="animation-delay: 0.4s;">
            <div class="card-header">
                <div class="card-icon products">
                    <i class="fas fa-box"></i>
                </div>
                <div class="card-trend down">
                    <i class="fas fa-arrow-down"></i>
                    <span>-3%</span>
                </div>
            </div>
            <div class="card-value">456</div>
            <div class="card-label">Sản phẩm</div>
        </div>
    </div>

    <div style="background: rgba(255,255,255,0.1); backdrop-filter: blur(20px); border-radius: 20px; padding: 30px; border: 1px solid rgba(255,255,255,0.2); margin-top: 30px;">
        <h2 style="color: white; margin-bottom: 20px;">Nội dung trang sẽ hiển thị tại đây</h2>
        <p style="color: rgba(255,255,255,0.8); line-height: 1.6;">
            Trong ASP.NET Core, hãy thay thế phần này bằng <code style="background: rgba(255,255,255,0.2); padding: 2px 8px; border-radius: 4px; color: #ffd93d;"></code>
            để render nội dung từ các trang con.
        </p>
    </div>
</main>