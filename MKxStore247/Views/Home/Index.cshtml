@using Microsoft.AspNetCore.Identity
@{
	ViewData["Title"] = "Market 247";
}
@inject SignInManager<UserApplication> SignInManager
@inject UserManager<UserApplication> UserManager
<link href="css/HomeStyle.css" rel="stylesheet" />
<style>
	.body-content {
		max-width: 1080px; /* hoặc 768px, 600px tùy ý */
		margin: 0 auto; /* canh giữa */
	}

	.custom-section {
		border-radius: 16px;
	}
</style>
@{
	var user = await UserManager.GetUserAsync(User);
	string roles = "";
	if (user != null)
	{
		var role = await UserManager.GetRolesAsync(user);
		roles = string.Join(", ", role).Trim();
	}
	var listCates = ViewBag.listCates;
}
@if (roles == "Admin")
{

}
else
{
	<header>
	</header>
	<section class="body-content container">
		<!-- Navigation Categories -->
		<nav class="nav-categories">
			<div class="container">
				<div class="d-flex flex-wrap gap-2">
					@{
						foreach (var item in listCates)
						{
							<a href="#" class="nav-link">@item.CategoryName</a>
						}
					}
				</div>
			</div>
		</nav>

		<!-- Hero Section -->
		<section class="hero-section">
			<div class="container">
				<div class="row align-items-center">
					<div class="col-lg-8">
						<div class="hero-content">
							<h2>Mua bán nhanh, <span style="color: #FAA03F">dễ dàng </span></h2>
							<p class="">
								Kết nối người mua và người bán trên toàn quốc. Đăng tin miễn phí, giao dịch an toàn.
							</p>
							<div class="hero-stats">
								<div class="stat-item">
									<span class="stat-number">1M+</span>
									<span>Tin đăng</span>
								</div>
								<div class="stat-item">
									<span class="stat-number">500K+</span>
									<span>Người dùng</span>
								</div>
								<div class="stat-item">
									<span class="stat-number">50K+</span>
									<span>Giao dịch/tháng</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Categories Section -->
		<section class="py-5 bg-white shadow custom-section mb-3">
			<div class="container">
				<h2 class="section-title text-center">Danh mục nổi bật</h2>
				<div class="category-grid">
					@{
						foreach (var item in listCates)
						{
							<a href="/ListProduct/@item.CategoryId" class="category-item">
								<div class="category-icon">
									<i class="@item.ImageUrl"></i>
								</div>
								<div>@item.CategoryName</div>
							</a>
						}
					}
				</div>
			</div>
		</section>

		<!-- San pham moi nhat -->
		<section class="custom-section py-5 bg-white shadow">
			<div class="container">
				<h2 class="section-title">Sản phẩm mới</h2>
				<div class="row g-4">
					@{
						var recentProducts = ViewBag.recentProducts as List<Product>;
						foreach (var itemProduct in recentProducts)
						{
							var mainImage = itemProduct.Images.FirstOrDefault(i => i.IsMain);
							<a href="Product/@itemProduct.ProductId" class="col-lg-3 col-md-4 col-sm-6 text-decoration-none">
								<div class="product-card">
									<img src="@mainImage?.ImageUrl" alt="@itemProduct.ProductName"
									     class="product-image">
									<div class="product-info">
										<div class="product-price">@itemProduct.Price.ToString("N0") đ</div>
										<div class="product-title small">@itemProduct.ProductName</div>
										<div class="product-location">
											<i class="fas fa-map-marker-alt me-1"></i>@itemProduct.Shop.City
										</div>
									</div>
								</div>
							</a>
						}
					}
				</div>
			</div>
		</section>
		<!-- San pham noi bat -->
		<section class="custom-section py-5 bg-white shadow mt-3">
			<div class="container">
				<h2 class="section-title">Sản phẩm nổi bật</h2>
				<div class="row g-4">
					@{
						var featuredProducts = ViewBag.featuredProducts as List<Product>;

						foreach (var itemProduct in featuredProducts)
						{
							var mainImage = itemProduct.Images.FirstOrDefault(i => i.IsMain);
							<div class="col-lg-3 col-md-4 col-sm-6">
								<div class="product-card">
									<img src="@mainImage?.ImageUrl" alt="@itemProduct.ProductName"
									     class="product-image">
									<div class="product-info">
										<div class="product-price">@itemProduct.Price.ToString("N0") đ</div>
										<div class="product-title">@itemProduct.Description</div>
										<div class="product-location">
											<i class="fas fa-map-marker-alt me-1"></i>@itemProduct.Shop.City
										</div>
									</div>
								</div>
							</div>
						}
					}
				</div>
			</div>
		</section>
	</section>

}


<script>
	// JavaScript cho các tương tác
	document.addEventListener('DOMContentLoaded', function () {
		// Smooth scroll cho các liên kết
		document.querySelectorAll('a[href^="#"]').forEach(anchor => {
			anchor.addEventListener('click', function (e) {
				e.preventDefault();
				const target = document.querySelector(this.getAttribute('href'));
				if (target) {
					target.scrollIntoView({
						behavior: 'smooth'
					});
				}
			});
		});

		// Tìm kiếm
		const searchBtn = document.querySelector('.btn-search');
		const searchInput = document.querySelector('.search-input');

		searchBtn.addEventListener('click', function () {
			const query = searchInput.value.trim();
			if (query) {
				alert('Tìm kiếm: ' + query);
				// Ở đây bạn có thể thêm logic tìm kiếm thực tế
			}
		});

		searchInput.addEventListener('keypress', function (e) {
			if (e.key === 'Enter') {
				searchBtn.click();
			}
		});

		// Hover effect cho product cards
		document.querySelectorAll('.product-card').forEach(card => {
			card.addEventListener('mouseenter', function () {
				this.style.transform = 'translateY(-5px)';
			});

			card.addEventListener('mouseleave', function () {
				this.style.transform = 'translateY(0)';
			});
		});
	});
</script>

