				<div class="category-grid">
					<a href="#" class="category-item">
						<div class="category-icon">
							<i class="fas fa-car"></i>
						</div>
						<div>Xe cộ</div>
					</a>
					<a href="#" class="category-item">
						<div class="category-icon">
							<i class="fas fa-home"></i>
						</div>
						<div>Bất động sản</div>
					</a>
					<a href="#" class="category-item">
						<div class="category-icon">
							<i class="fas fa-mobile-alt"></i>
						</div>
						<div>Điện thoại</div>
					</a>
					<a href="#" class="category-item">
						<div class="category-icon">
							<i class="fas fa-laptop"></i>
						</div>
						<div>Máy tính</div>
					</a>
					<a href="#" class="category-item">
						<div class="category-icon">
							<i class="fas fa-tshirt"></i>
						</div>
						<div>Thời trang</div>
					</a>
					<a href="#" class="category-item">
						<div class="category-icon">
							<i class="fas fa-couch"></i>
						</div>
						<div>Nội thất</div>
					</a>
					<a href="#" class="category-item">
						<div class="category-icon">
							<i class="fas fa-briefcase"></i>
						</div>
						<div>Việc làm</div>
					</a>
					<a href="#" class="category-item">
						<div class="category-icon">
							<i class="fas fa-paw"></i>
						</div>
						<div>Thú cưng</div>
					</a>
				</div>
			</div>
		</section>

		<!-- Featured Products -->
		<section class="custom-section py-5 bg-white shadow">
			<div class="container">
				<h2 class="section-title">Sản phẩm nổi bật</h2>
				<div class="row g-4">
					<div class="col-lg-3 col-md-4 col-sm-6">
						<div class="product-card">
							<img src="https://via.placeholder.com/300x200?text=iPhone+15" alt="iPhone 15"
								 class="product-image">
							<div class="product-info">
								<div class="product-price">25.000.000 đ</div>
								<div class="product-title">iPhone 15 Pro Max 256GB</div>
								<div class="product-location">
									<i class="fas fa-map-marker-alt me-1"></i>Hà Nội
								</div>
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-md-4 col-sm-6">
						<div class="product-card">
							<img src="https://via.placeholder.com/300x200?text=Honda+Vision" alt="Honda Vision"
								 class="product-image">
							<div class="product-info">
								<div class="product-price">28.000.000 đ</div>
								<div class="product-title">Honda Vision 2023</div>
								<div class="product-location">
									<i class="fas fa-map-marker-alt me-1"></i>TP. HCM
								</div>
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-md-4 col-sm-6">
						<div class="product-card">
							<img src="https://via.placeholder.com/300x200?text=MacBook" alt="MacBook"
								 class="product-image">
							<div class="product-info">
								<div class="product-price">35.000.000 đ</div>
								<div class="product-title">MacBook Pro M3 16 inch</div>
								<div class="product-location">
									<i class="fas fa-map-marker-alt me-1"></i>Đà Nẵng
								</div>
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-md-4 col-sm-6">
						<div class="product-card">
							<img src="https://via.placeholder.com/300x200?text=Căn+hộ" alt="Căn hộ"
								 class="product-image">
							<div class="product-info">
								<div class="product-price">2.5 tỷ</div>
								<div class="product-title">Căn hộ 2PN, full nội thất</div>
								<div class="product-location">
									<i class="fas fa-map-marker-alt me-1"></i>Hà Nội
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
	</section>
}



<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
<script>
	// JavaScript cho các tương tác
	document.addEventListener('DOMContentLoaded', function () {
		// Smooth scroll cho các liên kết
		document.querySelectorAll('a[href^="#"]').forEach(anchor => {
			anchor.addEventListener('click', function (e) {
				e.preventDefault();
				const target = document.querySelector(this.getAttribute('href'));
				if (target) {
					target.scrollIntoView({
						behavior: 'smooth'
					});
				}
			});
		});

		// Tìm kiếm
		const searchBtn = document.querySelector('.btn-search');
		const searchInput = document.querySelector('.search-input');

		searchBtn.addEventListener('click', function () {
			const query = searchInput.value.trim();
			if (query) {
				alert('Tìm kiếm: ' + query);
				// Ở đây bạn có thể thêm logic tìm kiếm thực tế
			}
		});

		searchInput.addEventListener('keypress', function (e) {
			if (e.key === 'Enter') {
				searchBtn.click();
			}
		});

		// Hover effect cho product cards
		document.querySelectorAll('.product-card').forEach(card => {
			card.addEventListener('mouseenter', function () {
				this.style.transform = 'translateY(-5px)';
			});

			card.addEventListener('mouseleave', function () {
				this.style.transform = 'translateY(0)';
			});
		});
	});
</script>

