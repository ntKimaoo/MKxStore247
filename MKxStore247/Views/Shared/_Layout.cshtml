<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - MKxStore247</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/MKxStore247.styles.css" asp-append-version="true" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

	<style>
		.navbar-chotot {
			background-color: #ffba00;
		}

		.navbar-logo {
			font-weight: bold;
			font-size: 24px;
			color: white;
			text-transform: uppercase;
			text-decoration: none;
		}

		.nav-icon-btn {
			background: none;
			border: none;
			font-size: 20px;
			color: #333;
			margin-right: 10px;
		}

		.btn-dangtin {
			background-color: #ff5722;
			color: white;
			font-weight: bold;
			border-radius: 4px;
			padding: 8px 16px;
		}

			.btn-dangtin:hover {
				background-color: #e64a19;
			}

		.form-control:focus {
			box-shadow: none;
		}
	</style>
</head>
<body>
	<header>
		<nav class="navbar navbar-expand-lg navbar-chotot py-2">
			<div class="container-fluid">
				<!-- Logo -->
				<a class="navbar-logo me-3" href="#">chợ xấu</a>

				<!-- Menu danh mục -->
				<button class="btn btn-light me-2 d-flex align-items-center">
					<i class="bi bi-list me-1"></i> Danh mục
				</button>

				<!-- Dropdown vùng miền -->
				<select class="form-select w-auto me-2">
					<option selected>Toàn Quốc</option>
					<option value="1">Hà Nội</option>
					<option value="2">TP.HCM</option>
				</select>

				<!-- Tìm kiếm -->
				<div class="input-group w-50 me-3">
					<input type="text" class="form-control" placeholder="Tìm kiếm sản phẩm trên Chợ Tốt">
					<button class="btn btn-dark"><i class="bi bi-search"></i></button>
				</div>

				<!-- Biểu tượng chức năng -->
				<button class="nav-icon-btn"><i class="bi bi-bell"></i></button>
				<button class="nav-icon-btn"><i class="bi bi-chat-dots"></i></button>
				<button class="nav-icon-btn"><i class="bi bi-person-circle"></i></button>

				<!-- Nút đăng tin -->
				<button class="btn btn-dangtin ms-2">Đăng Tin</button>
			</div>
		</nav>

	</header>
	<div class="container">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

	<footer class="border-top footer text-muted">
		<div class="container">
			&copy; 2025 - MKxStore247 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
		</div>
	</footer>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>

	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
