@using Microsoft.AspNetCore.Identity
@inject SignInManager<UserApplication> SignInManager
@inject UserManager<UserApplication> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - MKxStore247</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link href="~/css/Layout.css" rel="stylesheet">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

	<style>
		.navbar-chotot {
		background-color: #FAA03F;
		}

		.navbar-logo {
		font-weight: bold;
		font-size: 24px;
		color: white;
		text-transform: uppercase;
		text-decoration: none;
		}

		.nav-icon-btn {
		background: none;
		border: none;
		font-size: 20px;
		color: #333;
		margin-right: 10px;
		}

		.btn-dangtin {
		background-color: #ff5722;
		color: white;
		font-weight: bold;
		border-radius: 4px;
		padding: 8px 16px;
		}

		.btn-dangtin:hover {
		background-color: #e64a19;
		}

		.form-control:focus {
		box-shadow: none;
		}
	</style>
</head>
<body>
	@{
		var user = await UserManager.GetUserAsync(User);
		string roles = "";
		if (user != null)
		{
			var role = await UserManager.GetRolesAsync(user);
			roles = string.Join(", ", role).Trim();
		}
		
	}
	@if (roles == "Admin")
	{
		@RenderBody()
	}
	else
	{
		<header>
			<nav class="navbar navbar-expand-lg navbar-chotot py-3">
				<div class="container-fluid">
					<!-- Logo -->
					<a class="logo me-3" asp-controller="Home" asp-action="Index">MKxStore247</a>

					<!-- Menu danh mục -->
					<button class="btn btn-light me-2 d-flex align-items-center">
						<i class="bi bi-list me-1"></i> Danh mục
					</button>

					<!-- Dropdown vùng miền -->
					<select class="form-select w-auto me-2">
						<option selected>Toàn Quốc</option>
						<option value="1">Hà Nội</option>
						<option value="2">TP.HCM</option>
					</select>

					<!-- Tìm kiếm -->
					<div class="input-group me-3" style="width: 700px;">
						<input type="text" class="form-control" placeholder="Tìm kiếm sản phẩm trên Store 24/7">
						<button class="btn btn-dark"><i class="bi bi-search"></i></button>
					</div>



					<partial name="_LoginPartial" />
				</div>
			</nav>

		</header>
		<div class="container flex-grow-1">
			<main role="main" class="pb-3">
				@RenderBody()
			</main>
		</div>

		<footer class="border-top text-muted">
			<div class="container">
				<div class="row">
					<div class="col-lg-3 col-md-6">
						<h5>Về Chợ Tốt</h5>
						<ul class="list-unstyled">
							<li><a href="#">Giới thiệu</a></li>
							<li><a href="#">Quy định sử dụng</a></li>
							<li><a href="#">Chính sách bảo mật</a></li>
							<li><a href="#">Liên hệ</a></li>
						</ul>
					</div>
					<div class="col-lg-3 col-md-6">
						<h5>Hỗ trợ khách hàng</h5>
						<ul class="list-unstyled">
							<li><a href="#">Trung tâm trợ giúp</a></li>
							<li><a href="#">An toàn mua bán</a></li>
							<li><a href="#">Quy định đăng tin</a></li>
							<li><a href="#">Góp ý, khiếu nại</a></li>
						</ul>
					</div>
					<div class="col-lg-3 col-md-6">
						<h5>Danh mục</h5>
						<ul class="list-unstyled">
							<li><a href="#">Xe cộ</a></li>
							<li><a href="#">Bất động sản</a></li>
							<li><a href="#">Đồ điện tử</a></li>
							<li><a href="#">Thời trang</a></li>
						</ul>
					</div>
					<div class="col-lg-3 col-md-6">
						<h5>Kết nối với chúng tôi</h5>
						<div class="d-flex gap-3 mb-3">
							<a href="#"><i class="fab fa-facebook fa-2x"></i></a>
							<a href="#"><i class="fab fa-youtube fa-2x"></i></a>
							<a href="#"><i class="fab fa-instagram fa-2x"></i></a>
						</div>
						<p>Hotline: 1900 1003</p>
						<p>Email: hotro@chotot.com</p>
					</div>
				</div>
				<hr class="my-4">
				<div class="text-center">
					<p>&copy; 2025 Chợ Tốt. Bản quyền thuộc về Store 24/7.</p>
				</div>
			</div>
		</footer>
	}
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>

	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
