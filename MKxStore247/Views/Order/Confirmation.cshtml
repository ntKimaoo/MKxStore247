@model MKxStore247.Models.Order
@{
    ViewBag.Title = "Xác nhận đặt hàng";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Success Message -->
            <div class="text-center mb-5">
                <div class="mb-4">
                    <i class="fas fa-check-circle fa-5x text-success"></i>
                </div>
                <h2 class="text-success mb-3">Đặt hàng thành công!</h2>
                <p class="lead text-muted">
                    Cảm ơn bạn đã mua hàng tại cửa hàng của chúng tôi.
                    Đơn hàng của bạn đã được tiếp nhận và đang được xử lý.
                </p>
            </div>

            <!-- Order Info -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-receipt me-2"></i>
                        Thông tin đơn hàng
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-muted">Mã đơn hàng:</h6>
                            <p class="fw-bold">#@Model.OrderId</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Ngày đặt hàng:</h6>
                            <p class="fw-bold">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Trạng thái:</h6>
                            <span class="badge bg-warning text-dark">
                                @switch (Model.Status)
                                {
                                    case OrderStatus.Pending:
                                        <text>🕓 Đã đặt hàng</text>
                                        break;
                                    case OrderStatus.Confirmed:
                                        <text>✅ Đã xác nhận</text>
                                        break;
                                    case OrderStatus.Processing:
                                        <text>🛠️ Đang xử lý</text>
                                        break;
                                    case OrderStatus.Shipped:
                                        <text>🚚 Đã giao vận chuyển</text>
                                        break;
                                    case OrderStatus.InTransit:
                                        <text>🚛 Đang giao</text>
                                        break;
                                    case OrderStatus.Delivered:
                                        <text>📦 Đã giao</text>
                                        break;
                                    case OrderStatus.Completed:
                                        <text>🎉 Hoàn thành</text>
                                        break;
                                    case OrderStatus.Cancelled:
                                        <text>❌ Đã hủy</text>
                                        break;
                                    default:
                                        @Model.Status.ToString()
                                        break;
                                }
                            </span>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Phương thức thanh toán:</h6>
                            <p class="fw-bold">@Model.PaymentMethod.Name</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Shipping Address -->
            @if (Model.Address != null)
            {
                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-map-marker-alt me-2"></i>
                            Địa chỉ giao hàng
                        </h5>
                    </div>
                    <div class="card-body">
                        <h6 class="fw-bold">@Model.Address.AddressLine</h6>
                        <p class="mb-0">
                            <i class="fas fa-map-marker-alt me-2 text-muted"></i>
                            @Model.Address.AddressLine
                        </p>
                    </div>
                </div>
            }

            <!-- Order Items -->
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-list me-2"></i>
                        Chi tiết đơn hàng (@Model.Items.Count sản phẩm)
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (item.Product.Images.Any())
                                                {
                                                    <img src="@item.Product.Images.First().ImageUrl"
                                                         alt="@item.Product.ProductName"
                                                         class="img-thumbnail me-3"
                                                         style="width: 60px; height: 60px; object-fit: cover;">
                                                }
                                                else
                                                {
                                                    <div class="bg-light rounded me-3 d-flex align-items-center justify-content-center"
                                                         style="width: 60px; height: 60px;">
                                                        <i class="fas fa-image text-muted"></i>
                                                    </div>
                                                }
                                                <div>
                                                    <h6 class="mb-1">@item.Product.ProductName</h6>
                                                    <small class="text-muted">Shop: @item.Product.Shop.ShopName</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center align-middle">
                                            <span class="badge bg-light text-dark">@item.Quantity</span>
                                        </td>
                                        <td class="text-end align-middle">
                                            @item.UnitPrice.ToString("N0")₫
                                        </td>
                                        <td class="text-end align-middle">
                                            <span class="fw-bold text-primary">
                                                @((item.UnitPrice * item.Quantity).ToString("N0"))₫
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="card mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="fas fa-calculator me-2"></i>
                        Tóm tắt thanh toán
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Tạm tính:</span>
                                <span>@Model.TmpAmount.ToString("N0")₫</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Phí vận chuyển:</span>
                                <span>
                                    @if (Model.ShippingFee == 0)
                                    {
                                        <span class="text-success">Miễn phí</span>
                                    }
                                    else
                                    {
                                        @Model.ShippingFee.ToString("N0")

                                        <text>₫</text>
                                    }
                                </span>
                            </div>
                            @if (Model.DiscountAmount.HasValue && Model.DiscountAmount > 0)
                            {
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Giảm giá:</span>
                                    <span class="text-danger">-@Model.DiscountAmount.Value.ToString("N0")₫</span>
                                </div>
                            }
                            <hr>
                            <div class="d-flex justify-content-between">
                                <span class="h5 fw-bold">Tổng cộng:</span>
                                <span class="h5 fw-bold text-danger">@Model.TotalAmount.ToString("N0")₫</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Instructions -->
            @if (Model.PaymentMethod.Name.Contains("Banking"))
            {
                <div class="card mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-university me-2"></i>
                            Hướng dẫn thanh toán
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info">
                            <h6 class="fw-bold">Thông tin chuyển khoản:</h6>
                            <p class="mb-2"><strong>Ngân hàng:</strong> Vietcombank</p>
                            <p class="mb-2"><strong>Số tài khoản:</strong> 0123456789</p>
                            <p class="mb-2"><strong>Tên tài khoản:</strong> CONG TY MKXSTORE247</p>
                            <p class="mb-2"><strong>Số tiền:</strong> @Model.TotalAmount.ToString("N0")₫</p>
                            <p class="mb-0"><strong>Nội dung:</strong> Thanh toan don hang #@Model.OrderId</p>
                        </div>
                    </div>
                </div>
            }
            else if (Model.PaymentMethod.Name.Contains("Momo"))
            {
                <div class="card mb-4">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-mobile-alt me-2"></i>
                            Hướng dẫn thanh toán Momo
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info">
                            <h6 class="fw-bold">Thanh toán qua Momo:</h6>
                            <p class="mb-2"><strong>Số điện thoại:</strong> 0987654321</p>
                            <p class="mb-2"><strong>Tên tài khoản:</strong> MKXSTORE247</p>
                            <p class="mb-2"><strong>Số tiền:</strong> @Model.TotalAmount.ToString("N0")₫</p>
                            <p class="mb-0"><strong>Nội dung:</strong> Thanh toan don hang #@Model.OrderId</p>
                        </div>
                    </div>
                </div>
            }

            <!-- Action Buttons -->
            <div class="text-center mb-5">
                <a href="@Url.Action("", "Order", new { id = Model.OrderId })"
                   class="btn btn-primary btn-lg me-3">
                    <i class="fas fa-eye me-2"></i>
                    Xem chi tiết đơn hàng
                </a>
                <a href="@Url.Action("Index", "Home")"
                   class="btn btn-outline-primary btn-lg">
                    <i class="fas fa-shopping-bag me-2"></i>
                    Tiếp tục mua sắm
                </a>
            </div>

            <!-- Cancel Order -->
            @if (Model.Status == OrderStatus.Pending || Model.Status == OrderStatus.Confirmed)
            {
                <div class="text-center">
                    <button class="btn btn-outline-danger"
                            onclick="confirmCancelOrder(@Model.OrderId)">
                        <i class="fas fa-times me-2"></i>
                        Hủy đơn hàng
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Cancel Order Modal -->
<div class="modal fade" id="cancelOrderModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xác nhận hủy đơn hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn hủy đơn hàng này không?</p>
                <p class="text-muted small">
                    <i class="fas fa-info-circle me-1"></i>
                    Đơn hàng chỉ có thể hủy khi ở trạng thái "Đã đặt hàng" hoặc "Đã xác nhận".
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Không
                </button>
                <form method="post" action="@Url.Action("CancelOrder", "Order")" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" id="cancelOrderId" value="">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-times me-2"></i>
                        Xác nhận hủy
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmCancelOrder(orderId) {
            $('#cancelOrderId').val(orderId);
            $('#cancelOrderModal').modal('show');
        }

        // Auto print page (optional)
        $(document).ready(function() {
            // Uncomment if you want auto print
            // window.print();
        });
    </script>
}


    <style>
        .card {
            border: none;
            box-shadow: 0 2px 15px rgba(0,0,0,0.1);
            border-radius: 10px;
        }

        .card-header {
            border-radius: 10px 10px 0 0 !important;
            font-weight: 600;
        }

        .btn {
            border-radius: 6px;
            font-weight: 500;
        }

        .img-thumbnail {
            border-radius: 8px;
        }

        .table td {
            vertical-align: middle;
            border-top: 1px solid #f0f0f0;
        }

    </style>
